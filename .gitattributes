# Normalize line endings so a Windows checkout (core.autocrlf=true) doesn't
# break scripts that run inside Linux containers from a bind mount.
# Every text file checks out LF; git's binary detection (text=auto) leaves
# binary files alone.
* text=auto eol=lf

# Executed by Windows: always CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
